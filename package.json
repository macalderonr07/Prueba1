{
  "name": "ejemplo1-ci",
  "private": true,
  "version": "1.0.0",
  "description": "Herramientas de CI para validar HTML5, accesibilidad WCAG 2.1 AA, diseño responsivo y seguridad de enlaces externos.",
  "type": "module",
  "scripts": {
    "serve": "http-server . -p 8080 -s -c-1",
    "test:html": "html-validate \"*.html\"",
    "test:a11y": "start-server-and-test serve http://localhost:8080 test:a11y:run",
    "test:a11y:run": "pa11y-ci",
    "test:responsive": "start-server-and-test serve http://localhost:8080 test:responsive:run",
    "test:responsive:run": "node scripts/check-responsive.mjs",
    "test:links": "node scripts/check-links.mjs index.html"
  },
  "devDependencies": {
    "html-validate": "^8.18.1",
    "http-server": "^14.1.1",
    "pa11y-ci": "^3.1.0",
    "playwright": "^1.47.0",
    "start-server-and-test": "^2.0.5"
  }
}
